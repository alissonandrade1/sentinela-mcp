{
  "name": "sentinela",
  "version": "0.1.0",
  "description": "Infraestrutura de segurança para agentes de IA via MCP (Model Context Protocol)",
  "type": "module",
  "license": "MIT",
  "author": "Alisson Xavier",
  "homepage": "https://github.com/alissonandrade1/sentinela-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alissonandrade1/sentinela-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alissonandrade1/sentinela-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "audit",
    "ai-agents",
    "claude",
    "cursor",
    "vulnerability-scanner",
    "static-analysis",
    "code-audit"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "sentinela": "./dist/server.js"
  },
  "files": [
    "dist",
    "context.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.27.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.1"
  }
}
